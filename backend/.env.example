# Owner-level credential -- used only by the ingestion scripts, which
# need write access (INSERT/UPDATE/DDL).
DATABASE_URL=postgresql://user:password@host:port/dbname

# Least-privilege read-only role (nhl_api_readonly) -- used only by
# api.py. The API never writes, so it never needs (and should never be
# given) the owner-level credential above. api.py fails loudly at
# startup if this isn't set rather than falling back to DATABASE_URL.
API_DATABASE_URL=postgresql://nhl_api_readonly:password@host:port/dbname

# Optional -- Sentry error tracking. Get a DSN from a free project at
# sentry.io. If unset, api.py just runs without error reporting rather
# than failing to start (unlike API_DATABASE_URL above, this is an
# operational nice-to-have, not a functional requirement).
SENTRY_DSN=
# development | production -- Sentry groups issues by this. Set to
# "production" in the Azure Container App's real environment variables;
# leave unset (defaults to "development") for local runs.
SENTRY_ENVIRONMENT=

# Optional -- how many hours old standings_snapshots' most recent row can
# be before api.py's hourly background check logs a STALE_INGESTION error
# (picked up by the nhl-ingestion-stale Azure Monitor alert). Defaults to
# 30, which gives the 6am daily ingest_standings.py job a full day plus a
# generous buffer before paging anyone.
INGESTION_STALE_THRESHOLD_HOURS=
