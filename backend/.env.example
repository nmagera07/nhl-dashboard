# Owner-level credential -- used only by the ingestion scripts, which
# need write access (INSERT/UPDATE/DDL).
DATABASE_URL=postgresql://user:password@host:port/dbname

# Least-privilege read-only role (nhl_api_readonly) -- used only by
# api.py. The API never writes, so it never needs (and should never be
# given) the owner-level credential above. api.py fails loudly at
# startup if this isn't set rather than falling back to DATABASE_URL.
API_DATABASE_URL=postgresql://nhl_api_readonly:password@host:port/dbname
