# Optional -- backend URL. Defaults to the deployed Azure API. Set to
# http://127.0.0.1:8000 (in .env.local) to test against a local
# `uvicorn api:app --reload`.
VITE_API_BASE=

# Optional -- Sentry error tracking. Get a DSN from a free project at
# sentry.io (the same project as the backend's SENTRY_DSN, or a separate
# one -- either works, Sentry just tags events by platform). If unset,
# the app runs normally with no error reporting; the error boundary in
# main.jsx still catches render errors and shows a fallback UI either way.
VITE_SENTRY_DSN=
# development | production. Vite sets import.meta.env.PROD automatically
# based on `vite build` vs `vite dev`, so this only needs setting if you
# want to override that default.
VITE_SENTRY_ENVIRONMENT=

# Optional override for the separately deployed NHL Intelligence service.
# Production defaults to the public Cloud Run URL in src/config.js.
VITE_NHL_INTELLIGENCE_URL=

# Development-only historical game preview. The preview card is shown by
# `npm run dev` and omitted from production builds.
VITE_NHL_GAME_PREVIEW=true
VITE_NHL_GAME_PREVIEW_ID=2023020001
