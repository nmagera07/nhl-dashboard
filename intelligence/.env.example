NHL_DASHBOARD_API_URL=https://nhl-dashboard-api.bravecoast-a5240643.westus2.azurecontainerapps.io
ALLOWED_ORIGINS=http://localhost:5173,https://ashy-sky-01e4eba1e.7.azurestaticapps.net

# AI providers, tried in this order; any without credentials are skipped.
# Use free-tier keys with NO payment method attached, so they can only
# refuse (rate limit), never bill. See app/providers.py.
AI_PROVIDERS=gemini,groq,cloudflare,ollama

GEMINI_API_KEY=            # aistudio.google.com -> Get API key
# GEMINI_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=              # console.groq.com -> API Keys
# GROQ_MODEL=openai/gpt-oss-20b

CLOUDFLARE_ACCOUNT_ID=     # dash.cloudflare.com -> Workers AI
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Local GPU for development (ollama serve; ollama pull qwen2.5:7b)
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Paid fallback: only used if you add "openai" to AI_PROVIDERS.
# OPENAI_API_KEY=
